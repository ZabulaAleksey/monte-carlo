# PostgreSQL (replace these demo-only values outside local development)
POSTGRES_DB=montecarlo
POSTGRES_USER=montecarlo
POSTGRES_PASSWORD=change-me-for-non-local-use
POSTGRES_PORT=5432

# Backend
APP_NAME=MonteCarlo API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
