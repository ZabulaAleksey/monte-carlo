# PostgreSQL (replace these demo-only values outside local development)
POSTGRES_DB=montecarlo
POSTGRES_USER=montecarlo
POSTGRES_PASSWORD=change-me-for-non-local-use
POSTGRES_PORT=5432

# Backend
APP_NAME=MonteCarlo API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=true

# MetaTrader 5 bridge. MT5_API_KEY is consumed by backend; BridgeBaseUrl and
# BridgeTerminalId are copied into the Expert Advisor input parameters.
MT5_API_KEY=replace-with-at-least-32-random-characters
BridgeBaseUrl=http://127.0.0.1:8000
BridgeTerminalId=mt5-terminal-01
MT5_HEARTBEAT_TIMEOUT_SECONDS=90

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
